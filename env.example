# Copy these names into your host's environment panel and set the real values there.
# Never commit filled-in values.

# Speech-to-text
DEEPGRAM_API_KEY=

# LLM. Haiku 4.5 is the latency sweet spot for real-time voice (~0.4s TTFB).
# Sonnet is smarter but slower; Opus is too slow for a phone call.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Text-to-speech. multilingual_v2 renders non-English dish names far better than
# the turbo/flash English path, which matters on food calls.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional per-cuisine voice override, e.g. {"indian":"<voice_id>","default":"<voice_id>"}
ELEVENLABS_VOICE_MAP=

# Which TTS engine to run. One of: elevenlabs | deepgram | rime | cartesia.
# Swappable at runtime so engines can be A/B tested on live calls.
TTS_PROVIDER=elevenlabs

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased Twilio number, E.164 format
TWILIO_FROM_NUMBER=

# The public URL your host assigns this service, set after the first deploy
LOCAL_SERVER_URL=
ENV=local
