# ---- Copy these names into Railway's "Variables" panel and paste your real keys there. ----
# (You never send these to anyone; they live in Railway.)

# Speech-to-text
DEEPGRAM_API_KEY=

# LLM (the brain) — Anthropic. Sonnet is the sweet spot for real-time voice
# (smart enough for the nuance, fast enough to avoid dead air).
# Fallback if latency bites: claude-haiku-4-5.  Avoid Opus for voice (too slow).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Text-to-speech — ElevenLabs (the "Monika" voice)
ELEVENLABS_API_KEY=
# The ElevenLabs voice id for the Indian "Monika" voice — pick it in the ElevenLabs
# voice library and paste its id here (we'll confirm the exact one together).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Telephony — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased Twilio number, E.164:
TWILIO_FROM_NUMBER=

# The public URL Railway assigns this service, e.g. https://voice-caller-production.up.railway.app
# (Railway sets this automatically; paste your service's URL here after first deploy.)
LOCAL_SERVER_URL=
ENV=local
